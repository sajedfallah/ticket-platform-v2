# Production Environment Template

APP_ENV=production

# Backend
BACKEND_PORT=8000
JWT_SECRET=change_this_secret
CORS_ORIGINS=https://your-domain.com

# Database
POSTGRES_DB=ticket_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_password
DATABASE_URL=postgresql://postgres:password@postgres:5432/ticket_platform

# Redis
REDIS_URL=redis://redis:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=change_bot_token
TELEGRAM_WEBAPP_URL=https://your-domain.com/app

# Payment
PAYMENT_PROVIDER_KEY=change_payment_key

# Domain
DOMAIN=your-domain.com
SSL_EMAIL=admin@your-domain.com
